# Database — SQLite file path. Defaults to dev.db if unset.
DATABASE_URL=dev.db

# Public domain used to build restaurant URLs (fmnu.ir/r/<slug>).
# Defaults to fmnu.ir. Set to your real domain in prod.
NEXT_PUBLIC_DOMAIN=fmnu.ir

# SMS (Payamak Panel) — only required when NO_SMS=false.
# When NO_SMS is anything other than "false", OTP codes are logged to console.
NO_SMS=true
SMS_USERNAME=
SMS_PASSWORD=
SMS_FROM=

# Standard Next.js. Set to "production" for secure session cookies.
NODE_ENV=development
