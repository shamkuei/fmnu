# Database — SQLite file path. Defaults to dev.db if unset.
DATABASE_URL=dev.db

# Platform superadmin ("useradmin") — created/updated on every server boot.
# ROOT_PHONE accepts any Iranian/E.164 form (e.g. 09121234567 or +989121234567);
# it is normalized before storage. Changing ROOT_PASSWORD updates the stored hash.
ROOT_PHONE=
ROOT_PASSWORD=

# Public domain used to build restaurant URLs (fmnu.ir/r/<slug>).
# Defaults to fmnu.ir. Set to your real domain in prod.
NEXT_PUBLIC_DOMAIN=fmnu.ir

# SMS (Payamak Panel) — only required when NO_SMS=false.
# When NO_SMS is anything other than "false", OTP codes are logged to console.
NO_SMS=true
SMS_USERNAME=
SMS_PASSWORD=
SMS_FROM=

# Standard Next.js. Set to "production" for secure session cookies.
NODE_ENV=development

# Reverse proxy (jonasal/nginx-certbot). Required for HTTPS in prod.
# Let's Encrypt sends certificate expiry warnings here.
CERTBOT_EMAIL=
